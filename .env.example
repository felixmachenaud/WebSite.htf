# URL canonique du site (Open Graph, sitemap, robots). Sans barre finale.
# Exemple : https://www.exemple.fr
NEXT_PUBLIC_SITE_URL=

# Mentions légales hébergeur : vercel | ovh | pending (défaut si absent)
# SITE_HOSTING=pending

# Mini-CMS — noms seulement. Ne jamais committer de valeur.
ADMIN_PASSWORD_HASH=
AUTH_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secours si intégration Vercel KV (upstash-kv) — token read-write, pas KV_REST_API_READ_ONLY_TOKEN
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# Smoke admin externe uniquement (local, jamais committer) — mot de passe admin de l’env ciblé
# ADMIN_SMOKE_PASSWORD=
